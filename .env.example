# Runtime
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://matriva:change-me@db:5432/matriva
REDIS_URL=redis://redis:6379/0
VECTOR_DATABASE_URL=postgresql+psycopg://matriva:change-me@db:5432/matriva
AUTO_CREATE_TABLES=false
DEMO_MODE=true

# Browser/API
CORS_ORIGINS=http://localhost:3000

# Auth: generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-unique-random-value-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30

# Limits
MAX_UPLOAD_BYTES=10000000
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Optional providers (leave blank to use the safe local grounded fallback)
INSTALL_OPTIONAL=false
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=models/gemini-embedding-001
